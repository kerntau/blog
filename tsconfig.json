{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{ "name": "next" }
		],
		"paths": {
			"@/*": ["./src/*"],
			"~/*": ["./src/*"],
			"~~/*": ["./*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"blog.config.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"remark-plugins/**/*.ts",
		".next/types/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
