{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"],
			"~/*": ["./src/*"],
			"~~/*": ["./*"]
		}
	},
	"include": [
		"blog.config.ts",
		"rsbuild.config.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"remark-plugins/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
